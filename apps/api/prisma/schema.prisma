// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String     @id @default(uuid(7)) @db.Uuid
  email        String     @unique
  passwordHash String
  wallet       Wallet?
  orders       Order[]
  positions    Position[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

/// 사용자당 하나. 모의거래소라 USDT 한 종류만 다룬다
model Wallet {
  id        String        @id @default(uuid(7)) @db.Uuid
  userId    String        @unique @db.Uuid
  // 돈 기록은 지워지면 안 되므로, 지갑이 있는 사용자는 삭제할 수 없게 막는다
  user      User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  balance   Decimal       @db.Decimal(20, 8)
  entries   LedgerEntry[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

enum LedgerEntryType {
  SIGNUP_BONUS
  TRADING_FEE
  REALIZED_PNL
}

/// 원장: 잔고가 바뀔 때마다 한 줄씩 추가만 하고, 수정이나 삭제는 하지 않는다
model LedgerEntry {
  id           String          @id @default(uuid(7)) @db.Uuid
  walletId     String          @db.Uuid
  wallet       Wallet          @relation(fields: [walletId], references: [id], onDelete: Restrict)
  type         LedgerEntryType
  /// 부호 포함 변동 금액 (+10000, -2.5)
  amount       Decimal         @db.Decimal(20, 8)
  /// 이 기록 직후의 잔고
  balanceAfter Decimal         @db.Decimal(20, 8)
  /// 이 기록을 만든 주문 (수수료, 실현 손익). 가입 보너스처럼 주문과 무관하면 null
  orderId      String?         @db.Uuid
  order        Order?          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  createdAt    DateTime        @default(now())

  @@index([walletId, createdAt])
}

enum OrderSide {
  BUY
  SELL
}

enum OrderType {
  MARKET
}

enum OrderStatus {
  FILLED
}

enum PositionSide {
  LONG
  SHORT
}

/// 주문 기록. 시장가 주문은 받는 즉시 전부 체결되거나 거부된다 (거부된 주문은 저장하지 않는다)
model Order {
  id           String        @id @default(uuid(7)) @db.Uuid
  userId       String        @db.Uuid
  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  symbol       String
  side         OrderSide
  type         OrderType
  status       OrderStatus
  qty          Decimal       @db.Decimal(20, 8)
  leverage     Int
  /// 포지션을 줄이기만 하는 주문 (포지션이 없거나 같은 방향이면 거부)
  reduceOnly   Boolean       @default(false)
  /// 평균 체결가
  avgFillPrice Decimal       @db.Decimal(20, 8)
  fee          Decimal       @db.Decimal(20, 8)
  /// 포지션을 줄였을 때 확정된 손익 (열거나 늘릴 때는 0)
  realizedPnl  Decimal       @default(0) @db.Decimal(20, 8)
  entries      LedgerEntry[]
  createdAt    DateTime      @default(now())

  @@index([userId, createdAt])
}

/// 지금 열려 있는 포지션. 종목당 하나이고, 완전히 닫히면 삭제된다 (기록은 주문과 원장에 남는다)
model Position {
  id             String       @id @default(uuid(7)) @db.Uuid
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  symbol         String
  side           PositionSide
  qty            Decimal      @db.Decimal(20, 8)
  /// 평균 진입가
  entryPrice     Decimal      @db.Decimal(20, 8)
  leverage       Int
  /// 이 포지션에 묶인 증거금 (격리 마진)
  isolatedMargin Decimal      @db.Decimal(20, 8)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, symbol])
}
