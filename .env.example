# Docker
POSTGRES_USER=paper
POSTGRES_PASSWORD=paper
POSTGRES_DB=paper_futures
POSTGRES_PORT=5432
REDIS_PORT=6379

# API
NODE_ENV=development
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://paper:paper@localhost:5432/paper_futures
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-to-a-random-string-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7

# Market data
BINANCE_FUTURES_WS_URL=wss://fstream.binance.com

# Test (e2e)
TEST_DATABASE_URL=postgresql://paper:paper@localhost:5432/paper_futures_test
# Redis 0번은 개발용, 1번은 테스트용 (테스트마다 비워짐)
TEST_REDIS_URL=redis://localhost:6379/1
