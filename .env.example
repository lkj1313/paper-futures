# Docker
POSTGRES_USER=paper
POSTGRES_PASSWORD=paper
POSTGRES_DB=paper_futures
POSTGRES_PORT=5432
REDIS_PORT=6379

# API
NODE_ENV=development
API_PORT=3000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://paper:paper@localhost:5432/paper_futures
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=change-me-to-a-random-string-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m

# Test (e2e)
TEST_DATABASE_URL=postgresql://paper:paper@localhost:5432/paper_futures_test
